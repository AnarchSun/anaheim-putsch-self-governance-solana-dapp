#!/usr/bin/env bash
# PATH: anchor/anchor

set -e

# Utiliser le vrai binaire anchor
~/.cargo/bin/anchor "$@"

# Si on vient de faire "anchor build", on lance la mise à jour TypeScript
if [[ "$1" == "build" ]]; then
  echo "🔄 Post-build: mise à jour du Program ID…"

  # chemin absolu basé sur le répertoire du script
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  pnpm tsx "$SCRIPT_DIR/../scripts/update-program-id.ts"

  echo "✅ Program ID synchronisé avec src/config/solana.ts et .env.local"
fi
