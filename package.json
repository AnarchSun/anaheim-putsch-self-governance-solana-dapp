  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next dist out",
    "install:dapp": "pnpm solana:config:set && pnpm install && pnpm up && pnpm anchor:build",
    "anchor:build": "cd anchor && cargo clean && cargo update && anchor build  && cd .. && pnpm build",
    "anchor:deploy": "cd anchor && anchor deploy && cd ..",
    "anchor:test": "cd anchor && anchor test && cd ..",
    "anchor:clean": "cd anchor && cargo clean && anchor clean && cargo update && anchor build && cd ..",
    "solana:keygen": "mkdir -p anchor/target/deploy && mkdir -p /home/anarchsun/.config/solana && solana-keygen new --no-passphrase --outfile anchor/target/deploy/anarcrypt.json --force && solana config set --keypair anchor/target/deploy/anarcrypt.json && solana config set --url devnet && solana airdrop 5 && solana balance && solana address",
    "solana:config:set": "solana-keygen new --no-bip39-passphrase --outfile /home/anarchsun/.config/solana/id.json --force && solana config set --keypair /home/anarchsun/.config/solana/id.json && solana config set --url devnet && solana airdrop 5 && solana address && solana balance && solana config get",
    "docker:build": "docker build -t anaheim:latest .",
    "docker:tag": "docker tag anaheim:latest anarchsun/anaheim:latest",
    "docker:push": "docker push anarchsun/anaheim:latest",
    "docker:run": "docker run -p 3000:3000 anaheim:latest",
    "scaffold:init": "ts-node ./scripts/init-template.ts",
    "scaffold:fetch": "ts-node ./scripts/fetch-templates.ts",
    "sync": "pnpm anchor:build && pnpm lint",
    "putsch:deploy": "pnpm anchor:deploy && echo 'Deployed on devnet!'",
    "anchor:initialize": "tsx anchor/scripts/initialize.ts"
  },
