  "engines": {
    "node": ">=20.0.0",
    "pnpm": "10.18.1"
  },
  "workspaces": [
    "src/gill"
  ],
  "pnpm": {
    "ignore-workspace-root-check": true,
    "engine-strict": false,
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "bigint-buffer",
      "blake-hash",
      "buffer utils",
      "bufferutil",
      "esbuild",
      "keccak",
