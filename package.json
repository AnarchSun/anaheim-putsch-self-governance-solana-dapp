  "version": "0.0.1.666",
  "private": true,
  "description": "Next.js, Tailwind, gill (based on @solana/kit), Wallet UI",
  "keywords": [
    "gill",
    "nextjs",
    "react",
    "solana-kit",
    "tailwind",
    "typescript",
    "wallet-ui"
  ],
